# Keep the build context small and never bake local state / secrets into the image.
venv/
.venv/
**/__pycache__/
**/*.pyc
.git/
.forgejo/
# Runtime state roots. The bare-metal layout puts every store under ./data
# (Windows default, and Linux with WHISPER_DATA_DIR=./data — the same layout
# .gitignore covers), so the top-level patterns below never see them: Docker
# matches these with filepath.Match, where * does not cross a /. Without the
# ** forms (`**/` matches zero directories too, so they cover the context
# root as well) a local `docker build` bakes dictation audio, transcript
# text, API-key hashes and session-token hashes into an image layer.
data/
models/
/logs/
/captures/
# Log files under an in-repo DATA_DIR not named data/. Not `**/logs/`: that
# matches a directory at any depth and would silently drop a future
# faster_whisper_backend/logs/ package from every image (same trap as
# `**/captures/`, see tests/test_ci_workflow_config.py).
**/*.log
**/*.log.*
**/*.local.*
**/*.sqlite3
**/*.sqlite3-wal
**/*.sqlite3-shm
**/.env
**/.env.*
# The docker-compose files document ./secrets/bootstrap_admin_key.txt (and
# .env.example documents an hf_token beside it) as the *_FILE secret source.
# It is a bind-mount source, never needed inside the image, and none of the
# patterns above match it — a local `docker build` baked a full-admin
# bootstrap key into a layer. Verified by building a context and listing it.
# Root-relative only: `**/secrets/` would also drop a future
# faster_whisper_backend/secrets/ package (the `**/logs/` trap above).
secrets/
# Windows service artifacts (generated on the Windows host).
WhisperAPI.exe
WhisperAPI.xml
WhisperAPI.wrapper.log
nssm.exe
# Pinned Windows shared-build ffmpeg extracted by install-service.ps1 -Full
# (gitignored; ~150 MB of DLLs, unusable in a Linux image).
ffmpeg/
# Editor / preview cruft.
*-preview.html
# Review ledgers + local test cruft (gitignored; keep them out of LOCAL builds
# too — CI builds from a clean checkout and never sees them).
SECURITY-REVIEW_NOTES.md
CODE-REVIEW_NOTES.md
SIMPLIFY_NOTES.md
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/
tmp/
.vscode/
.idea/
# Gitignored local data that carries transcript text or dictation audio.
manifest.jsonl
*.wav
*.mp3
*.m4a
# Tracked trees nothing in the image reads at runtime: the test suite runs on
# the CI runner, not in the image, and the installers / compose files run on
# the host. `*.md` is root-only here (static/VENDOR.md still ships).
# requirements*.txt must NOT be listed: the Dockerfiles COPY them by name.
tests/
docs/
scripts/
.claude/
*.md
install-service.*
uninstall-service.*
docker-compose*.yml
Dockerfile*
