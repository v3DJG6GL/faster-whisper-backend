# Coverage configuration. Measures the faster_whisper_backend package;
# excludes the tests themselves, the manual scripts (scripts/), the
# virtualenvs, the docs tooling (docs/), and the uvicorn launcher
# (faster_whisper_backend/__main__.py runs the server at import, so the
# suite can never execute it).
[run]
branch = True
omit =
    tests/*
    docs/*
    scripts/*
    venv/*
    .venv/*
    faster_whisper_backend/__main__.py

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
