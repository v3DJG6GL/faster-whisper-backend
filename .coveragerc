# Coverage configuration. Measures the application package and the yt-dlp
# SSRF guard plugin (test_ssrf_guard.py loads the guard
# in-process by path, so its lines map back to ytdlp_plugins/).
#
# Omitted:
# - faster_whisper_backend/__main__.py runs the server at import, so the
#   suite can never execute it.
# - ytdlp_plugins/run_guarded_yt_dlp.py is the launcher the guard runs as a
#   subprocess. test_ssrf_guard.py loads it in-process too, but only for
#   its fail-closed path; the success path (it execs yt-dlp) only ever runs
#   in the subprocess, which coverage does not follow here.
[run]
branch = True
source =
    faster_whisper_backend
    ytdlp_plugins
omit =
    faster_whisper_backend/__main__.py
    ytdlp_plugins/run_guarded_yt_dlp.py

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
    raise NotImplementedError
