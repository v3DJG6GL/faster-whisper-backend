# GPU image — same base as the CPU Dockerfile, plus the NVIDIA CUDA 12 / cuDNN 9
# runtime wheels (requirements-gpu.txt) that ctranslate2 loads for GPU inference.
#
# HOST requirements: an NVIDIA driver (CUDA 12.x-capable) + the NVIDIA Container
# Toolkit, and the container must be started with GPU access — see
# docker-compose.gpu.yml. With no GPU visible at runtime, model load
# auto-falls back to CPU/int8 (config.py MODEL_DEVICE_FALLBACK), still functional.
#
# Build/run:
#   docker compose -f docker-compose.gpu.yml up -d   (standalone GPU compose file)
#
# Base pinned by digest (supply chain: a retagged or tampered upstream image
# can't slip in unnoticed). Digest = the multi-arch index of python:3.14-slim
# (Python 3.14.6, Debian 13). To bump:
#   docker buildx imagetools inspect python:3.14-slim
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Base + GPU deps first, for layer caching. The GPU wheels are large (~1 GB).
COPY requirements.txt requirements-gpu.txt requirements-diarize.txt requirements-bgm.txt requirements-translate.txt ./
RUN pip install --upgrade pip \
 && pip install -r requirements.txt -r requirements-gpu.txt

# Optional heavy extras (INCLUDE_EXTRAS=1 → the "-full" tag): speaker
# diarization + music separation. torch comes from the cu126 index so the
# image keeps ONE cu12 userspace (PyPI-default torch 2.12+ would pull the
# cu13 stack alongside — two CUDA userspaces in one process is asking for
# trouble). Caveat observed in run 390: torch cu126 hard-pins OLDER
# nvidia-cublas-cu12 / nvidia-cudnn-cu12 than requirements-gpu.txt's floors,
# so pip uninstalls the 12.9/9.24 libs from the previous layer and installs
# torch's 12.6/9.5 pins (~2 min churn + the old copies linger as whiteouts).
# Still cublas 12.x / cudnn 9.x, which is all ctranslate2 (and main.py's
# Windows DLL preloader majors) require — accepted until the -full build
# is restructured into a single pip resolution. audio-separator's [gpu]
# extra swaps onnxruntime for onnxruntime-gpu. ffmpeg from apt for
# torchcodec / audio-separator decoding.
# gcc/g++ are BUILD-time only: audio-separator's diffq dependency ships no
# cp314 wheel and compiles from source (run 372 failed on "No such file or
# directory: 'gcc'"). Purged in the same RUN so the compiler never reaches
# the final layer.
ARG INCLUDE_EXTRAS=0
RUN if [ "${INCLUDE_EXTRAS}" = "1" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends ffmpeg gcc g++ \
      && pip install -r requirements-diarize.txt "audio-separator[gpu]>=0.44" \
           "audioread>=2.1.9" "librosa<1.0" \
           --extra-index-url https://download.pytorch.org/whl/cu126 \
      # onnxruntime-gpu >=1.27 on PyPI is a CUDA 13 build — on this image's
      # cu12 userspace its CUDA provider fails to dlopen at session creation
      # and ORT silently runs the separation on the CPU (observed 2026-08-26:
      # GPU 0%, ~0.4x realtime). 1.26.x is the last CUDA 12.8 + cuDNN 9
      # build (cp314 wheels exist). Forced LAST so its files also win over
      # the CPU-only `onnxruntime` that faster-whisper pulls in (both
      # distributions unpack into the same onnxruntime/ package dir).
      && pip install --force-reinstall --no-deps "onnxruntime-gpu==1.26.*" \
      # Text-to-text translation: llama-cpp-python from the project's CUDA
      # wheel index. No cu126 index exists — the cu124 wheels run fine on
      # this image's cu12.6 userspace (CUDA 12 minor-version compatibility:
      # a cu124-linked binary loads against any >=12.4 CUDA 12 runtime).
      # The index publishes py3-none wheels, so Python 3.14 is covered.
      # Fallback if the wheel ever breaks: build from source with
      #   CMAKE_ARGS="-DGGML_CUDA=on" pip install llama-cpp-python
      # — but that needs a CUDA -devel base image (nvcc) and ~20 min.
      # The wheel bundles its own libggml/llama and dlopens CUDA libs from
      # torch's pip-installed nvidia/* dirs, already on LD_LIBRARY_PATH below.
      && pip install "llama-cpp-python>=0.3.34" \
           --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cu124 \
      && apt-get purge -y gcc g++ \
      && apt-get autoremove -y \
      && rm -rf /var/lib/apt/lists/* ; \
    fi

# ctranslate2 dlopens libcublas / libcudnn at runtime but does not search
# site-packages, and main.py's CUDA-lib preloader is Windows-only — so put the
# pip-installed NVIDIA .so dirs on the loader path here. The path is fixed by the
# python:3.14-slim base; update the "python3.14" segment if you bump the base.
#
# The list goes beyond ctranslate2's cublas+cudnn: in the -full image,
# onnxruntime-gpu's CUDAExecutionProvider additionally dlopens cudart, cufft
# and curand (and cusolver/cusparse/nvjitlink transitively) — all shipped as
# torch's pip deps but invisible to the loader, so the provider silently fell
# back to CPU and MDX separation maxed the CPU while logging "loaded on cuda".
# Entries that don't exist in the lean image are skipped by the loader.
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.14/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.14/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.14/site-packages/nvidia/cuda_runtime/lib:/usr/local/lib/python3.14/site-packages/nvidia/cuda_nvrtc/lib:/usr/local/lib/python3.14/site-packages/nvidia/cufft/lib:/usr/local/lib/python3.14/site-packages/nvidia/curand/lib:/usr/local/lib/python3.14/site-packages/nvidia/cusolver/lib:/usr/local/lib/python3.14/site-packages/nvidia/cusparse/lib:/usr/local/lib/python3.14/site-packages/nvidia/nvjitlink/lib

# Non-root runtime user — mirrors Dockerfile (see the comments there). The
# compose `user:` line (PUID/PGID) overrides the runtime UID/GID at run time.
ARG PUID=1000
ARG PGID=1000
RUN groupadd -g "${PGID}" app \
 && useradd -u "${PUID}" -g "${PGID}" -M -s /usr/sbin/nologin app \
 && mkdir -p /data /models \
 && chmod 0777 /data /models

# App code. Runtime state lives on mounted volumes — see docker-compose.yml.
COPY . .

# Build identity: CI stamps the `git describe` string here (see ci.yml) so
# /v1/models and the WebUI can report the exact build — the image carries no
# .git to describe at runtime (.dockerignore). Local builds default to "dev".
ARG BUILD_VERSION=dev
ENV WHISPER_BUILD_VERSION=${BUILD_VERSION}

EXPOSE 8000

USER ${PUID}:${PGID}
ENV HOME=/tmp

CMD ["python", "main.py"]
