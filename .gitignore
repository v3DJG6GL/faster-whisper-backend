# Virtual environments: venv/ is what the installers create, .venv/ the dev venv
venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Local environment / secrets
# secrets/ is the docker-compose *_FILE mount source (bootstrap_admin_key.txt,
# hf_token) — a commit away from the public GitHub mirror without this.
# Anchored like /logs/ and /tmp/: the mount source is the root ./secrets/
# (docker-compose.yml), and an unanchored secrets/ would silently drop a
# future faster_whisper_backend/secrets/ package.
/secrets/
.env
# Every .env variant, matching .dockerignore: .env.example documents
# WHISPER_BOOTSTRAP_ADMIN_KEY (creates the first full admin) and
# WHISPER_HF_TOKEN as the values that belong in such a file, and `main`
# is mirrored to a public GitHub repo — so .env.prod / .env.docker / .env.gpu
# must not be committable. The tracked example file is negated back in.
.env.*
!.env.example

# Admin-WebUI runtime overrides (the .example.json variant IS committed)
config.local.json

# filelock sidecars from the atomic JSON writer's save serialisation
# (config.json.lock, config.local.json.lock, model_sizes.json.lock,
# stage_rates.json.lock) — runtime artefacts, never committed. Narrowed to
# *.json.lock so a lockfile a tool wants committed (uv.lock, …) is not swallowed.
*.json.lock

# In-checkout data/model roots — the Windows bare-metal defaults (<repo>\data,
# <repo>\models); also cover Linux runs with WHISPER_DATA_DIR=./data
/data/
/models/

# Every SQLite store (+ WAL/SHM sidecars) named *.local.sqlite3 — reports,
# captures, sessions, recent transcriptions, API keys, usage, client settings,
# jobs, system metrics. Several hold PHI, transcript text or credential hashes.
# Their default home is {DATA_DIR}/db (covered by /data/ when DATA_DIR=./data);
# the glob also covers a store pointed anywhere else inside the checkout.
*.local.sqlite3
*.local.sqlite3-wal
*.local.sqlite3-shm

# Whisper fine-tuning capture audio — the legacy repo-root dir (the current
# default is {DATA_DIR}/captures). Anchored: an unanchored captures/ would
# also swallow faster_whisper_backend/captures/ and tests/captures/.
/captures/

# Capture-export manifest — carries transcript text out of the capture store
manifest.jsonl

# Editor / IDE
.vscode/
.idea/
*.swp

# OS noise
.DS_Store
Thumbs.db

# Test artifacts / temp uploads
*.log
*.log.*
/tmp/
/logs/
*.wav
*.mp3
*.m4a
# URL_MEDIA_DIR = {DATA_DIR}/url_media: retained link downloads and uploaded
# videos (.webm/.mp4/.mkv/.opus, which the globs above miss) under an
# in-checkout DATA_DIR not named data/ (WHISPER_DATA_DIR=./state).
# Unanchored on purpose, like .dockerignore's **/url_media/: no package or
# test dir of that name exists.
url_media/

# Auto-downloaded / generated by install-service.ps1 (per-deployment, no need to commit)
WhisperAPI.exe
WhisperAPI.xml
WhisperAPI.wrapper.log
# Pinned shared-build ffmpeg, downloaded by install-service.ps1 -Full when no
# shared ffmpeg is on PATH (faster_whisper_backend/main.py puts ffmpeg/bin on the service PATH)
/ffmpeg/
# Legacy NSSM era — install-service.ps1 -RemoveLocal cleans this up
nssm.exe

# Local review ledgers (code review / security review / simplify runs)
SIMPLIFY_NOTES.md
CODE-REVIEW_NOTES.md
SECURITY-REVIEW_NOTES.md
.review-run*/

# Tool caches
.ruff_cache/

# Claude Code per-user settings (project-shared .claude/ content may be committed)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
